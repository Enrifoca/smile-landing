            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          request a demo
        </button>
        <a href="https://github.com/enrifoca/smile" class="hero__cta" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z"/>
          </svg>
          view on github
        </a>
      </div>
    </header>

    <section class="showcase" aria-label="product preview video">
      <video autoplay muted loop playsinline aria-label="smile:D demo video">
        <source src="demo/smile-v0.2.0.mp4" type="video/mp4">
      </video>
    </section>

    <section class="section" aria-labelledby="built-heading">
      <p id="built-heading" class="section__title">what you get</p>
      <h2 class="section__headline">an agent connected to everything you use</h2>
      <p class="section__lede">we do not sell seats to a generic assistant. we create the modules, connectors, and approval flows your team needs, then hand you a desktop agent your employees can install.</p>

      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          </div>
          <h3 class="feature-card__name">open source</h3>
          <p class="feature-card__desc">open code and open architecture. no vendor lock in, no hidden APIs, no black box you cannot inspect.</p>
        </article>

        <article class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          </div>
          <h3 class="feature-card__name">use any model</h3>
          <p class="feature-card__desc">plug in the models that fit your budget and policy. switch between chat, reasoning, and vision models anytime. no forced provider.</p>
        </article>

        <article class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <h3 class="feature-card__name">optimized for small models</h3>
          <p class="feature-card__desc">designed to get the most out of lightweight models, so you keep costs low without giving up quality on real tasks.</p>
        </article>

        <article class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </div>
          <h3 class="feature-card__name">custom connectors</h3>
          <p class="feature-card__desc">HubSpot, Jira, databases, internal APIs, files. if a connector does not exist, we build it for you. the agent talks to your stack, not a generic one.</p>
        </article>

        <article class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <h3 class="feature-card__name">reports</h3>
          <p class="feature-card__desc">gathers context, drafts sections, and produces structured reports in your format. built for long form output, not one line answers.</p>
        </article>

        <article class="feature-card">
          <div class="feature-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <h3 class="feature-card__name">long running tasks</h3>
          <p class="feature-card__desc">multi step workflows run for minutes or hours, checkpointing progress and resuming safely. the agent does not lose state when a call times out.</p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="how-heading">
      <p id="how-heading" class="section__title">how it works</p>
      <h2 class="section__headline">from your workflow to a shipped agent</h2>
      <p class="section__lede">we act as your delivery partner. you describe the job, we create the agent, and your team installs it like any desktop app.</p>

      <div class="steps">
        <article class="step">
          <h3 class="step__name">describe the job</h3>
          <p class="step__desc">book a call and tell us what reports or tasks the agent should handle, which tools it needs, and who approves the output.</p>
        </article>
        <article class="step">
          <h3 class="step__name">we create it</h3>
          <p class="step__desc">we design the modules, connectors, approval flows, and report templates. the agent runs locally and uses your chosen models.</p>
        </article>
        <article class="step">
          <h3 class="step__name">ship to your team</h3>
          <p class="step__desc">your employees download a branded desktop app for mac, windows, or linux. no coding required on their side.</p>
        </article>
        <article class="step">
          <h3 class="step__name">iterate together</h3>
          <p class="step__desc">we refine connectors and modules as your processes change. you stay in control of data, models, and costs.</p>
        </article>
      </div>
    </section>

    <section class="section cta-band" aria-labelledby="cta-heading">
      <h2 id="cta-heading" class="cta-band__title">ready to get your own agent?</h2>
      <p class="cta-band__desc">tell us what your team needs and we will show you what a custom smile:D agent looks like for your company.</p>
      <button class="hero__cta hero__cta--primary" data-open-demo>request a demo</button>
    </section>

    <footer class="footer">
      <p class="footer__copy">built by enrico focaccia</p>
      <nav class="footer__links" aria-label="Footer">
        <a href="/blog/">blog</a>
        <a href="https://github.com/enrifoca/smile" target="_blank" rel="noopener">github</a>
        <a href="https://github.com/enrifoca/smile/releases" target="_blank" rel="noopener">releases</a>
        <a href="https://www.linkedin.com/company/smile-agent/" target="_blank" rel="noopener">linkedin</a>
      </nav>
    </footer>
  </div>

  <div class="modal" id="demo-modal" role="dialog" aria-modal="true" aria-labelledby="demo-title">
    <div class="modal__panel">
      <div class="modal__header">
        <h2 id="demo-title" class="modal__title">request a demo</h2>
        <button class="modal__close" data-close-demo aria-label="Close">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <form id="demo-form">
        <div class="form__group">
          <label class="form__label" for="demo-email">work email</label>
          <input class="form__input" type="email" id="demo-email" name="email" placeholder="you@company.com" required />
        </div>
        <div class="form__group">
          <label class="form__label" for="demo-company">company</label>
          <input class="form__input" type="text" id="demo-company" name="company" placeholder="acme inc." />
        </div>
        <div class="form__group">
          <label class="form__label" for="demo-message">what should the agent do?</label>
          <textarea class="form__textarea" id="demo-message" name="message" placeholder="e.g. we need a weekly report that pulls data from our CRM and drafts a summary for the sales team." required></textarea>
        </div>
        <button type="submit" class="form__submit">send request</button>
        <p class="form__note">this opens your email client with a pre-filled message. if it does not work, email us directly at <a href="mailto:hello@smile-agent.dev" style="text-decoration: underline;">hello@smile-agent.dev</a>.</p>
      </form>
    </div>
  </div>

  <script>
    (function () {
      // Demo modal
      const modal = document.getElementById('demo-modal');
      const openBtns = document.querySelectorAll('[data-open-demo]');
      const closeBtn = document.querySelector('[data-close-demo]');

      function openModal() {
        modal.classList.add('is-open');
        document.getElementById('demo-email').focus();
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        modal.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      openBtns.forEach(btn => btn.addEventListener('click', openModal));
      closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal(); });

      // Demo form -> mailto
      const form = document.getElementById('demo-form');
      const CONTACT_EMAIL = 'hello@smile-agent.dev'; // TODO: replace with your receiving address

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const email = document.getElementById('demo-email').value.trim();
        const company = document.getElementById('demo-company').value.trim();
        const message = document.getElementById('demo-message').value.trim();

        const subject = 'Demo request for smile:D';
        const body = [
          'Hi, I would like to request a demo of smile:D.',
          '',
          'Email: ' + email,
          company ? 'Company: ' + company : '',
          '',
          'Use case:',
          message
        ].join('\n');

        window.location.href = 'mailto:' + CONTACT_EMAIL +
          '?subject=' + encodeURIComponent(subject) +
          '&body=' + encodeURIComponent(body);

        closeModal();
      });
    })();
  </script>

</body>
</html>
