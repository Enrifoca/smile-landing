---
import BlogLayout from '../../layouts/BlogLayout.astro';

const postModules = import.meta.glob('./*.md', { eager: true });
const posts = Object.values(postModules)
  .map((mod: any) => ({ url: mod.url, frontmatter: mod.frontmatter }))
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<BlogLayout title="Blog" description="Notes on building custom enterprise AI agents, report automation, and long running workflows with smile:D.">
  <header>
    <h1 class="blog__title">Blog</h1>
    <p class="blog__lede">Notes on building custom enterprise AI agents, report automation, and long running workflows.</p>
  </header>

  <main class="post-list">
    {posts.map(post => (
      <a class="post-card" href={post.url}>
        <p class="post-card__date">{post.frontmatter.date}</p>
        <h2 class="post-card__title">{post.frontmatter.title}</h2>
        {post.frontmatter.excerpt && <p class="post-card__excerpt">{post.frontmatter.excerpt}</p>}
      </a>
    ))}
  </main>

  <style>
    .blog__title { font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 500; letter-spacing: -0.04em; margin: 0 0 0.5rem; }
    .blog__lede { font-size: 1.0625rem; color: var(--muted); margin: 0 0 2.5rem; line-height: 1.6; }

    .post-list { display: flex; flex-direction: column; gap: 1rem; }
    .post-card { display: block; border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; background: var(--bg); transition: border-color 0.2s, box-shadow 0.2s; }
    .post-card:hover { border-color: var(--ink); box-shadow: 0 4px 20px rgba(15,23,42,0.05); }
    .post-card__date { font-size: 0.8125rem; color: var(--muted); margin-bottom: 0.5rem; }
    .post-card__title { font-size: 1.25rem; font-weight: 500; margin: 0 0 0.5rem; color: var(--ink); }
    .post-card__excerpt { font-size: 0.9375rem; color: var(--muted); line-height: 1.55; margin: 0; }
  </style>
</BlogLayout>
